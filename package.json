{
  "name": "bee",
  "version": "0.3.9",
  "description": "Bee: a meeting notch overlay that surfaces relevant local notes and short guidance.",
  "license": "MIT",
  "author": "Bee contributors",
  "private": true,
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "check:asar": "vvedantb-check-asar list --default-asar release/mac-arm64/Bee.app/Contents/Resources/app.asar --default-asar release/mac/Bee.app/Contents/Resources/app.asar --scan out/main --scan out/preload --require electron-store",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:gateway": "vitest run --config vitest.gateway.config.ts",
    "test:e2e": "electron-vite build && vitest run --config vitest.e2e.config.ts",
    "relay:mock": "esbuild relay/src/dev.ts --bundle --platform=node --format=esm --outfile=out/relay-dev.mjs --log-level=warning && node out/relay-dev.mjs",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.94",
    "@ai-sdk/openai": "^4.0.78",
    "@clerk/electron": "^0.0.47",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@vvedantb/mcp-client": "^0.1.0",
    "ai": "^7.0.116",
    "electron-store": "^8.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@clerk/clerk-react": "^5.61.10",
    "@electron/asar": "^4.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@tabler/icons-react": "^3.48.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-hotkeys": "^0.15.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vvedantb/config": "^0.2.0",
    "@vvedantb/ui": "^0.4.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.46.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "motion": "^12.43.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadow-plugin": "^2.1.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "build": {
    "appId": "app.bee.desktop",
    "productName": "Bee",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "resources/**",
      "package.json",
      "!node_modules/esbuild{,/**}",
      "!node_modules/@esbuild{,/**}",
      "!node_modules/vite{,/**}",
      "!node_modules/vitest{,/**}",
      "!node_modules/electron-vite{,/**}",
      "!node_modules/electron-builder{,/**}",
      "!node_modules/typescript{,/**}",
      "!node_modules/convex{,/**}",
      "!node_modules/react-native*{,/**}",
      "!node_modules/@react-native*{,/**}",
      "!node_modules/metro*{,/**}",
      "!node_modules/@babel{,/**}",
      "!node_modules/@solana{,/**}",
      "!node_modules/@solana-mobile{,/**}",
      "!node_modules/@wallet-standard{,/**}"
    ],
    "protocols": [
      {
        "name": "Bee",
        "schemes": [
          "bee"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "artifactName": "Bee-Setup-${version}.${ext}",
      "oneClick": true,
      "perMachine": false
    },
    "mac": {
      "artifactName": "Bee-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "resources/icon-mac.png",
      "hardenedRuntime": true,
      "notarize": false,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.inherit.plist",
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "Bee listens to your microphone during meetings to transcribe speech and suggest tips. Audio is sent only for transcription.",
        "NSAudioCaptureUsageDescription": "Bee can capture meeting audio to transcribe it. This is optional.",
        "NSScreenCaptureUsageDescription": "Bee can capture system (meeting) audio, which macOS counts as screen recording. This is optional."
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "resources/icon.png",
      "mimeTypes": [
        "x-scheme-handler/bee"
      ]
    },
    "npmRebuild": false
  },
  "engines": {
    "node": ">=22"
  }
}
