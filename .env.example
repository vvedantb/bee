# Seeds the AI Gateway key when none is saved in Settings. Also used by npm run test:gateway.
BEE_AI_GATEWAY_API_KEY=

# Optional: personalised link suggestions (vmem history and bookmarks, ranked by Jev through the Gateway key above).
# The base URL is the Convex site URL, https only. A key and URL saved in Settings win. VMEM_API_KEY and VMEM_BASE_URL also work.
BEE_VMEM_API_KEY=
BEE_VMEM_BASE_URL=

# Optional: Clerk publishable key. Defaults to the vedantb.com production instance.
VITE_CLERK_PUBLISHABLE_KEY=

# Optional: Bee relay for Teams mode (Convex HTTP site; see relay/README.md).
# Without it Teams mode is off and Bee works solo.
# BEE_RELAY_URL is read at run time; MAIN_VITE_BEE_RELAY_URL is baked into a build (for installers).
BEE_RELAY_URL=
MAIN_VITE_BEE_RELAY_URL=
